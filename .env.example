# Spotify Developer Dashboard → your app
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Must match Redirect URI in Spotify Dashboard exactly (no trailing slash)
# Production (Vercel):
SPOTIFY_REDIRECT_URI=https://YOUR-APP-NAME.vercel.app/api/auth/callback

# Random string for signing session cookies (openssl rand -base64 32)
SESSION_SECRET=generate_a_long_random_string

# Optional: set on Vercel automatically; override for custom domains
# NEXT_PUBLIC_APP_URL=https://YOUR-APP-NAME.vercel.app
